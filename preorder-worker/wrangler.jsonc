{
  // Pre-order email sign-ups for the landing page. See README.md to deploy.
  "name": "repup-preorder",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://shinehyeuk-pixel.github.io"
  },
  "kv_namespaces": [
    { "binding": "PREORDERS", "id": "REPLACE_WITH_KV_ID" }
  ]
}
